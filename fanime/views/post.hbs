<div class="main-website-structure">
{{>nav2}}
<div class="website-body">
    {{>topics}}
    <div class="content"> <!--Posts to be added-->
        {{>contentheader}}
        <div class="post-margin">
            <div class="post-area">
                {{#with post}}
                <div class="noclick-post" data-post-id="{{_id}}">
                    <div class="post-header">
                        <div class="post-title">
                            <h2>{{title}}</h2>
                        </div>
                            <h4>{{genre}}</h4>
                        <div class="post-profile">
                            <img src={{profilepicture}}>
                        </div>
                        <h4>{{username}}</h4>
                        <h6>Posted on {{date}}</h6>
                        {{#if editDate}}
                        <h6>Edited on {{editDate}}</h6>
                        {{/if}}
                    </div>
                    {{#if image}}
                    <div class="post-body">{{description}}</div>
                    <div class="post-img">
                        <img src={{image}}>
                    </div>
                    {{else}}
                    <div class="post-body">{{description}}</div>
                    {{/if}}
                    <div class="post-action">
                        <i class="fa fa-thumbs-up like" data-post-id="{{_id}}">{{like}}</i>
                        <i class="fa fa-thumbs-down dislike" data-post-id="{{_id}}">{{dislike}}</i>
                    </div>
                    <div class="comment">
                        <div class="comment-form">
                            <textarea placeholder="Write your comment here..." id="comment-data" maxlength="300"></textarea>
                            <button type="button" id="submit-comment" onclick="clearTextarea()" >Comment</button>
                        </div>
                    </div>
                <div class="comment-section">
                    <div class="comment-container">
                        {{#each comments}}
                        <div class="comment-text show-replies"> <!-- Added 'clickable' class -->
                            <div class="comment-inner">
                                <div class="comment-user">
                                    <p>{{user}}</p>
                                </div>
                                <div class="comment-body">{{text}}</div>
                            </div>  
                            <div class="reply-container" style="display: none;">
                                <div class="reply-form" >
                                        <textarea class="reply-data" placeholder="Write your reply here..." maxlength="300"></textarea>
                                        <button class="submit-reply">Reply</button>
                                </div>
                                
                                {{#if replies.length}}
                                <div class="replies">
                                    {{#each replies}}
                                    <div class="reply">
                                        <div class="reply-user">
                                            <p>{{user}}</p>
                                        </div>
                                        <div class="reply-body">{{text}}</div>
                                    </div>
                                    {{/each}}
                                </div>
                                {{/if}}

                            </div>
                        </div>
                        

                        {{/each}}
                    </div>

                </div>

             </div>
                {{/with}}
            </div>
        </div>
    </div>

    {{>filterPosts}}
</div>
</div>