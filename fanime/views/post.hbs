<div class="main-website-structure">
{{>nav2}}
<div class="website-body">
    {{>topics}}
    <div class="content"> <!--Posts to be added-->
        {{>contentheader}}
        <div class="post-margin">
            <div class="post-area">
                {{#with post}}
                <form action="create_comment" method="post">
                <div class="noclick-post" data-post-id="{{_id}}">
                        <div class="post-header">
                            <div class="post-title">
                                <h2>{{title}}</h2>
                            </div>
                                <h4>{{genre}}</h4>
                            <div class="post-profile">
                                <img src={{profilepicture}}>
                            </div>
                            <h4>{{username}}</h4>
                            <h6>Posted on {{date}}</h6>
                            {{#if editDate}}
                            <h6>Edited on {{editDate}}</h6>
                            {{/if}}
                        </div>
                        {{#if image}}
                        <div class="post-body">{{description}}</div>
                        <div class="post-img">
                            <img src={{image}}>
                        </div>
                        {{else}}
                        <div class="post-body">{{description}}</div>
                        {{/if}}
                        <div class="post-action">
                            <i class="fa fa-thumbs-up like" data-post-id="{{_id}}">{{like}}</i>
                            <i class="fa fa-thumbs-down dislike" data-post-id="{{_id}}">{{dislike}}</i>
                            <div class="expand-comment-section">Expand</div>
                        </div>
                            <input type="hidden" name="post-id" value="{{_id}}">
                            <div class="comment">
                                <div class="comment-form">
                                    <textarea name="commentData" placeholder="Write your comment here..." id="comment-data" maxlength="300" required></textarea>
                                    <button type="submit" id="submit-comment" onclick="clearTextarea()" >Comment</button>
                                </div>
                            </div>
                        </form>
                    <div class="comment-section">
                        <div class="comment-container">
                        {{#if comments}}
                            {{#each comments}}
                            <div class="comment-text show-replies"> <!-- Added 'clickable' class -->
                                    <div class="comment-inner in-post">
                                        <div class="comment-user">
                                            <p>{{user}}</p>
                                        </div>
                                        <div class="comment-body">{{text}}</div>
                                    </div>  
                                    <div class="reply-container" style="display: none;">
                                        <form action="create_reply" method="post">
                                            <input type="hidden" name="comment-id" value="{{_id}}">
                                            <input type="hidden" name="post-id-inComment" value="{{../_id}}">
                                            <div class="reply-form" >
                                                    <textarea name="replyData" class="reply-data" placeholder="Write your reply here..." maxlength="250"></textarea>
                                                    <button type="submit" class="submit-reply">Reply</button>
                                            </div>
                                        </form>
                                        {{#if replies.length}}
                                        <div class="replies">
                                            {{#each replies}}
                                            <div class="reply">
                                                <div class="reply-user">
                                                    <p>{{user}}</p>
                                                </div>
                                                <div class="reply-body">{{text}}</div>
                                            </div>
                                            {{/each}}   
                                        </div>
                                        {{/if}}
                                    </div>
                            </div>
                            {{/each}}
                        {{else}}
                            <p class="nonemsg">Wow such empty...</p>
                        {{/if}}
                        </div>

                    </div>

                </div>
                {{/with}}
            </div>
        </div>
    </div>

    {{>filterPosts}}
</div>
</div>