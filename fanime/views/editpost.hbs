<div class="main-website-structure">
{{>nav2}}
<div class="website-body">
    <div class="content"> <!--Posts to be added-->
        {{>contentheader}}
        <div class="post-margin">
            <div class="post-area">
                <div class="post-create">
                    {{#with post}}
                    <form action="submit_edit_post" method="post">
                        <div class="post-form">
                            <div class="post-texts">
                                <input type="text" name="post-title" id="post-title" class="enter-post-title" placeholder="Title" value="{{title}}" required>
                                <textarea name="postDesc" rows="2" cols="50" id="post-description" class="enter-post-desc" placeholder="Write your post here..." required>{{description}}</textarea>
                            </div>
                            <div class="post-buttons">
                                <div class="post-buttons-bottom">
                                        <button type="submit" name="editBtn" value="{{id}}">Edit</button>
                                </div>
                            </div>
                        </div>
                    </form>
                    {{/with}}
                </div>
        </div>
    </div>
</div>
</div>