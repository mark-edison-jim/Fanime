<div class="main-website-structure">
{{>nav2}}
<div class="website-body">
    {{>topics}}
    <div class="content"> <!--Posts to be added-->
        {{>contentheader}}
        <div class="post-margin">
            <div class="post-area" id="post-area">
                <div class="post-create">
                    <form action="newPost" method="post" enctype="multipart/form-data">
                        <div class="post-form">
                                        <div class="post-texts">
                                    <input type="text" name="post-title" id="post-title" class="enter-post-title" placeholder="Title (Max 30 Characters)" required maxlength="30"> <!-- Maximum of 100 characters -->
                                    <textarea name="postDesc" rows="2" cols="50" id="post-description" class="enter-post-desc" placeholder="Write your post here... (Max 500 Characters)" required maxlength="500"></textarea> <!-- Maximum of 500 characters -->
                                </div>
                            <div class="post-buttons">
                                <div class="post-buttons-top">
                                    <select name="post-tag" id="post-genre" required>
                                        <option value="" disabled selected>Select Tag</option>
                                        <option>Action</option>
                                        <option>Adventure</option>
                                        <option>Comedy</option>
                                        <option>Drama</option>
                                        <option>Fantasy</option>
                                        <option>Romance</option>
                                        <option>Slice of Life</option>
                                        <option>Science Fiction</option>
                                        <option>Horror</option>
                                        <option>Mystery</option>
                                    </select>
                                </div>
                                <div class="post-buttons-mid">
                                    <!--
                                        <label for="file-input" class="post-image">
                                        <img id="filepic" src="https://cdn.pixabay.com/photo/2017/11/10/04/47/image-2935360_1280.png"/>
                                        </label>
                                        <input id="" name="postimg" type="file"/>
                                    -->
                                   <label for="file-input" class="image-upload">
                                    <img src="camera.png" alt="Add Image">
                                    <input type="file" id="file-input" name="postimg" accept="image/*" style="display: none;" />
                                    <span class="tooltiptext">Add Image</span>
                                    <span class="filename-text"></span>
                                </label>

                                </div>
                                <div class="post-buttons-bottom">
                                    <button type="submit" id="submit-post">Post</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                {{#each posts}}
                <div class="post" data-post-id="{{_id}}">
                    <div class="post-header" >
                        <div class="post-title">
                            <h2>{{title}}</h2>
                        </div>
                            <h4>{{genre}}</h4>
                        <div class="post-profile">
                            <img src="{{profilepicture}}">
                        </div>
                        <h4>{{username}}</h4>
                        <h6>Posted on {{date}}</h6>
                        {{#if editDate}}
                        <h6>Edited on {{editDate}}</h6>
                        {{/if}}
                    </div>
                    {{#if image}}
                    <div class="post-body">{{description}}</div>
                    <div class="post-img">
                        <img src={{image}}>
                    </div>
                    {{else}}
                    <div class="post-body">{{description}}</div>
                    {{/if}}
                    <div class="post-action">
                        <i class="fa fa-thumbs-up like" data-post-id="{{_id}}">{{like}}</i>
                        <i class="fa fa-thumbs-down dislike" data-post-id="{{_id}}">{{dislike}}</i>
                        <button class="toggle-comment-section" >Comments</button>
                    </div>
                    <div id="comment-section" class="comment-section" style="display: none;">
                        <div class="comment-container">
                            {{#each comments}}
                            <div class="comment">
                                <div class="comment-inner">
                                    <div class="comment-user">
                                        <p>{{user}}</p>
                                    </div>
                                    <div class="comment-body">{{text}}</div>
                                </div>
                                <div class="reply-container">
                                    {{#if replies.length}}
                                    <div class="replies">
                                        {{#each replies}}
                                        <div class="reply">
                                            <div class="reply-user">
                                                <p>{{user}}</p>
                                            </div>
                                            <div class="reply-body">{{text}}</div>
                                        </div>
                                        {{/each}}
                                    </div>
                                    {{/if}}
                                </div>

                            </div>
                            {{/each}}
                        </div>
                    </div>

                </div>
                {{/each}}
            </div>
        </div>
    </div>

    {{>filterPosts}}
</div>
</div>